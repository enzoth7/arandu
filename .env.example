# Public application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-development-publishable-key

# Server database. Use only a disposable local Supabase instance for tests.
SUPABASE_PROJECT_REF=replace-with-development-project-ref
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace-locally
SUPABASE_DB_SSL_MODE=disable
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-development-service-role-key

# Demo features are off unless both flags are explicitly enabled.
DEMO_MODE=false
DEMO_INTAKE_ENABLED=false
ALLOW_DEMO_RESET=false

# Institutional demo session and separate role credentials.
INSTITUTIONAL_SESSION_SECRET=replace-with-at-least-32-random-characters
STATE_DEMO_USERNAME=estado-demo
STATE_DEMO_PASSWORD=replace-with-a-strong-local-password
FACILITY_DEMO_USERNAME=elepem-demo
FACILITY_DEMO_PASSWORD=replace-with-a-different-strong-local-password
FACILITY_DEMO_ORGANIZATION_ID=ORG-DEMO-001
FACILITY_DEMO_IDS=DEMO-ELEPEM-001

# Chatwoot public verification and private n8n delivery.
CHATWOOT_WEBHOOK_SECRET=replace-with-chatwoot-webhook-secret
N8N_CHATWOOT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/alerta-mayor-whatsapp-sandbox
N8N_CHATWOOT_FORWARD_SECRET=replace-with-at-least-32-random-characters
N8N_INTAKE_HMAC_SECRET=replace-with-at-least-32-random-characters
INTAKE_PHONE_HASH_PEPPER=replace-with-at-least-32-random-characters
